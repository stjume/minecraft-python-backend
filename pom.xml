<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.sk</groupId>
    <artifactId>stminecraft</artifactId>
    <version>1.2</version>
    <packaging>jar</packaging>

    <name>stminecraft</name>

    <developers>
        <developer>
            <name>Adrian Oeyen</name>
            <email>oeyenadrian@gmail.com</email>
        </developer>
        <developer>
            <name>Chris Geron</name>
            <email>git@chris-ge.de</email>
        </developer>
        <developer>
            <name>sk stiftung jugend und medien der Sparkasse KölnBonn</name>
            <email>info@sk-jugend.de</email>
        </developer>
    </developers>

    <properties>
        <!-- Defaults are overridden by the build profiles below; see the mc1.21 / mc26 profiles. -->
        <java.version>21</java.version>
        <spigot.version>1.21.4-R0.1-SNAPSHOT</spigot.version>
        <plugin.api.version>1.21</plugin.api.version>
        <build.target>mc1.21</build.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <profiles>
        <!-- Legacy target: Minecraft 1.21.x on Java 21. Active unless another profile is selected. -->
        <profile>
            <id>mc1.21</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <properties>
                <java.version>21</java.version>
                <spigot.version>1.21.4-R0.1-SNAPSHOT</spigot.version>
                <plugin.api.version>1.21</plugin.api.version>
                <build.target>mc1.21</build.target>
            </properties>
        </profile>

        <!-- Current target: Minecraft 26.x on Java 25. Select with -Pmc26. -->
        <profile>
            <id>mc26</id>
            <properties>
                <java.version>25</java.version>
                <spigot.version>26.3-R0.1-SNAPSHOT</spigot.version>
                <plugin.api.version>26.0</plugin.api.version>
                <build.target>mc26</build.target>
            </properties>
        </profile>
    </profiles>

    <build>
        <defaultGoal>clean package</defaultGoal>
        <finalName>${project.artifactId}-${project.version}-${build.target}</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.14.0</version>
                <configuration>
                    <release>${java.version}</release>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.3</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
    </build>

    <repositories>
        <repository>
            <id>spigotmc-repo</id>
            <url>https://hub.spigotmc.org/nexus/content/repositories/snapshots/</url>
        </repository>
        <repository>
            <id>sonatype</id>
            <url>https://oss.sonatype.org/content/groups/public/</url>
        </repository>
    </repositories>

    <dependencies>
        <dependency>
            <groupId>org.spigotmc</groupId>
            <artifactId>spigot-api</artifactId>
            <version>${spigot.version}</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>
</project>
